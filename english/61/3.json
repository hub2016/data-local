    {
      "title": "Reading time",
      "mp3": "Readingtime",
      "list": [
        {
          "name": "",
          "en": "My name is Right Hand. This is my twin brother, Left Hand.",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "One day, our master didn't wash us and ate his food. He felt ill the next day. Now he washes us before every meal.",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "On another day, our master had a bad cold. He had a runny nose and a cough. We wiped his nose and covered his mouth with a tissue. We're important for his health.",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "Happiness is important for good health. One day, our master felt unhappy, so we helped him make handicrafts (手工艺品). He felt happy again.",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "Our master also cooked food for his family. They thanked him and told him, \"You have really great hands!\"",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "We're important for our master and his friends. He uses us to give them a high five!",
          "mp3": "",
          "cn": ""
        },
        {
          "name": "",
          "en": "We really are helping hands!",
          "mp3": "",
          "cn": ""
        }
      ]
